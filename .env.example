# ==============================================================================
# APP CONFIGURATION
# ==============================================================================
APP_NAME="My App"
APP_ENV=development             # development, staging, production
APP_KEY=base64:UbFEhshq0DfX38RmBaIEXiN+uC+hAGTPu7wzK6ylVFU=                        # Jalankan command generator dari framework Anda (misal: php artisan key:generate)
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_PORT=3000

# ==============================================================================
# DATABASE CONFIGURATION (Pilih salah satu sesuai DBMS Anda)
# ==============================================================================
# PostgreSQL / MySQL / MariaDB
DB_CONNECTION=sqlite             # mysql, pgsql, sqlite, mariadb            
DB_HOST=127.0.0.1
DB_PORT=3306                    
DB_DATABASE=pos_farham
DB_USERNAME=root
DB_PASSWORD=

# MongoDB (Jika menggunakan NoSQL)
MONGO_URI=mongodb://localhost:27017/nama_database

# ==============================================================================
# AUTHENTICATION & SECURITY (JWT / Session)
# ==============================================================================
JWT_SECRET=                     # Isi dengan string random yang panjang dan aman
JWT_EXPIRES_IN=7d
SESSION_SECRET=                 # Isi dengan string random untuk cookie session

# OAuth (Social Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=${APP_URL}/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=${APP_URL}/auth/github/callback

# ==============================================================================
# MAIL / SMTP CONFIGURATION (Untuk Kirim Email)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io      # Ganti dengan mail server Anda (misal: ://gmail.com)
MAIL_PORT=2525                  # 2525, 587, atau 465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls             # tls atau ssl
MAIL_FROM_ADDRESS="no-reply@myapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# CACHE & REDIS CONFIGURATION
# ==============================================================================
CACHE_STORE=database            # database, redis, file, memcached
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# THIRD-PARTY SERVICES & API KEYS (Opsional)
# ==============================================================================
# AWS S3 (Cloud Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# Payment Gateway (Misal: Midtrans / Stripe)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

STRIPE_KEY=
STRIPE_SECRET=

# Cloudinary (Image Hosting)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
